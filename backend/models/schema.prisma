// backend/models/schema.prisma
// Copy this to backend/prisma/schema.prisma for Prisma to pick it up

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  username  String   @unique
  avatarUrl String?
  role      Role     @default(USER)
  createdAt DateTime @default(now())

  votes     Vote[]
  chatMessages ChatMessage[]
  comments  Comment[]
}

enum Role {
  USER
  MODERATOR
  ADMIN
}

model Song {
  id          String   @id @default(cuid())
  title       String
  artist      String
  anime       String
  genre       String
  coverUrl    String?
  audioUrl    String?  // For licensed/self-hosted audio
  externalId  String?  // e.g. listen.moe track ID
  duration    Int      // seconds
  playCount   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  votes       Vote[]
  queueItems  QueueItem[]
  playHistory PlayHistory[]
}

model Vote {
  id        String   @id @default(cuid())
  userId    String
  songId    String
  createdAt DateTime @default(now())
  sessionId String?  // For anonymous votes

  user      User     @relation(fields: [userId], references: [id])
  song      Song     @relation(fields: [songId], references: [id])

  @@unique([userId, songId])  // One vote per user per song per cycle
}

model QueueItem {
  id        String   @id @default(cuid())
  songId    String
  position  Int
  cycleId   String   // Group votes by voting cycle
  createdAt DateTime @default(now())

  song      Song     @relation(fields: [songId], references: [id])

  @@index([cycleId, position])
}

model PlayHistory {
  id        String   @id @default(cuid())
  songId    String
  playedAt  DateTime @default(now())
  listeners Int      @default(0)

  song      Song     @relation(fields: [songId], references: [id])
}

model Article {
  id          String      @id @default(cuid())
  title       String
  slug        String      @unique
  excerpt     String
  content     String      @db.Text
  coverUrl    String?
  category    ArticleCategory
  tags        String[]
  published   Boolean     @default(false)
  publishedAt DateTime?
  views       Int         @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  comments    Comment[]
}

enum ArticleCategory {
  ANIME_REVIEW
  NEWS
  MUSIC
  ANALYSIS
  INTERVIEW
  LIST
}

model MangaPick {
  id          String   @id @default(cuid())
  title       String
  author      String
  coverUrl    String?
  genre       String[]
  status      MangaStatus
  latestChapter Int?
  synopsis    String
  externalUrl String?  // Link to legal reader (e.g. MangaPlus)
  isFeatured  Boolean  @default(false)
  staffPick   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum MangaStatus {
  ONGOING
  COMPLETED
  HIATUS
}

model ExclusiveContent {
  id          String          @id @default(cuid())
  title       String
  description String
  type        ExclusiveType
  mediaUrl    String?
  thumbnailUrl String?
  duration    Int?            // seconds for video/audio
  isMembersOnly Boolean       @default(true)
  published   Boolean         @default(false)
  createdAt   DateTime        @default(now())
}

enum ExclusiveType {
  INTERVIEW
  BEHIND_SCENES
  STUDIO_TOUR
  MUSIC_BREAKDOWN
  LIVE_SESSION
}

model ChatMessage {
  id        String   @id @default(cuid())
  userId    String
  message   String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id])
}

model Comment {
  id        String   @id @default(cuid())
  userId    String
  articleId String
  content   String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id])
  article   Article  @relation(fields: [articleId], references: [id])
}

model RadioStats {
  id          String   @id @default(cuid())
  timestamp   DateTime @default(now())
  listeners   Int
  cycleId     String
}
